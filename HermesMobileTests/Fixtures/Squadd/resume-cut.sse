data: {"kind":"message.patch","threadId":"ae0770b2-1152-45a7-9d17-4053d27ea3a6","message":{"id":"8bb25636-c159-406b-9841-964057889168","at":1795145751974,"parentId":null,"role":"bot","kind":"options","text":"Hey! I'm Squadd. I'm new here. I'm here to be your Chief of Staff. I can manage your other bots. Task me with anything. I'll make sure it gets to the right bot. I'm taking a look around to see if there's anything I can pick up for you. I'll follow up in a moment.","helperIntro":true,"card":{"title":"Hey! I'm Squadd. I'm new here.","subtitle":"I'm here to be your Chief of Staff. I can manage your other bots. Task me with anything. I'll make sure it gets to the right bot. I'm taking a look around to see if there's anything I can pick up for you. I'll follow up in a moment.","options":["What are my bots up to?","Set up a bot for my inbox","Make me a morning routine","How do I connect my email?"],"fixedOptions":true,"dismissed":true}},"seq":5}

